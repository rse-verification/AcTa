# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "dev"
synopsis: "CBMC harness generation from ACSL entry contracts"
description: """
This plugin for the Frama-C platform reads the ACSL contract of an entry
function and generates a C harness suitable for execution by CBMC."""
maintainer: ["Scania"]
authors: ["The AcTa development team"]
license: "GPL-2.0-or-later"
homepage: "https://github.com/rse-verification/AcTa"
bug-reports: "https://github.com/rse-verification/AcTa/issues"
depends: [
  "dune" {>= "3.13"}
  "ocaml" {>= "4.14"}
  "frama-c" {>= "31" & < "32"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "--promote-install-files=false"
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
  ["dune" "install" "-p" name "--create-install-files" name]
]
dev-repo: "git+https://github.com/rse-verification/AcTa.git"
